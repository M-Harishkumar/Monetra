rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for User profile
    function isValidUser(data) {
      return data.id is string &&
             data.email is string && data.email.size() <= 200 &&
             data.name is string && data.name.size() <= 150 &&
             data.role in ['ADMIN', 'STAFF', 'CUSTOMER'] &&
             data.createdAt is string && data.createdAt.size() <= 40;
    }

    // Validation for Chat Message
    function isValidChatMessage(data) {
      return data.id is string &&
             data.userId is string && data.userId == request.auth.uid &&
             data.sender in ['user', 'model', 'system'] &&
             data.content is string && data.content.size() <= 10000 &&
             data.timestamp is string && data.timestamp.size() <= 40;
    }

    // Validation for Audio Transcription
    function isValidTranscription(data) {
      return data.id is string &&
             data.userId is string && data.userId == request.auth.uid &&
             data.transcript is string && data.transcript.size() <= 100000 &&
             data.createdAt is string && data.createdAt.size() <= 40;
    }

    // Users Collection & Profiles
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // PII isolation - no listing of user documents

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUser(incoming()) &&
                       incoming().id == userId;

      allow update: if isOwner(userId) &&
                       incoming().id == existing().id &&
                       incoming().email == existing().email &&
                       incoming().role == existing().role && // Prevent role escalation
                       incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt']);

      allow delete: if false; // Protect user accounts from deletion

      // User's private conversation history
      match /chatMessages/{messageId} {
        allow read, write: if isOwner(userId) && isValidId(messageId);
        allow create: if isOwner(userId) && isValidId(messageId) && isValidChatMessage(incoming());
      }

      // User's private audio transcriptions
      match /audioTranscriptions/{transcriptionId} {
        allow read, write: if isOwner(userId) && isValidId(transcriptionId);
        allow create: if isOwner(userId) && isValidId(transcriptionId) && isValidTranscription(incoming());
      }
    }
  }
}
